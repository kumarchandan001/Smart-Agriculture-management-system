# backend/.env (create from this template and DO NOT commit your real .env)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart_agri
JWT_SECRET=supersecret_jwt_key_change_this
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://localhost:5001

# Government of India Open Data Mandi API (data.gov.in)
# Register and generate your free API key at: https://data.gov.in/
MARKET_API_KEY=your_data_gov_in_api_key_here
MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070?api-key={KEY}&format=json&filters[commodity]={CROP}&limit=1
